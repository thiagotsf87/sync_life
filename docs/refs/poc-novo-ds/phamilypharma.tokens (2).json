    "$type": "color",
    "brand": {
      "green": {
        "$value": "#09543d",
        "$description": "primary"
      },
      "greenDark": {
        "$value": "#04261c"
      },
      "brown": {
        "$value": "#461e10",
        "$description": "secondary"
      },
      "brownDark": {
        "$value": "#1c0c07"
      },
      "cream": {
        "$value": "#fffdf7"
      },
      "pink": {
        "$value": "#ffa9e9"
      }
    },
    "accent": {
      "blue": {
        "$value": "#3d3ef3"
      },
      "yellow": {
        "$value": "#ffc200"
      },
      "orange": {
        "$value": "#f45c24"
      },
      "lime": {
        "$value": "#ccf337"
      },
      "magenta": {
        "$value": "#dc3f81"
      },
      "violet": {
        "$value": "#6d0596"
