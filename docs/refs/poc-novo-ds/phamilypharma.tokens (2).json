        "$description": "headings, uppercase"
      },
      "body": {
        "$value": [
          "Poppins",
          "Helvetica Neue",
          "Helvetica",
          "Arial",
          "sans-serif"
        ]
      }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": {
        "$value": 400
      },
      "semibold": {
        "$value": 600
      },
      "bold": {
        "$value": 700
      }
    }
  },
  "typography": {
